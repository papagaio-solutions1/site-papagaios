{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"scripts/bus.ps1\" hookRead -Reader codex -HookEventName SessionStart",
            "timeout": 15,
            "statusMessage": "Lendo recados novos do Claude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"scripts/bus.ps1\" hookRead -Reader codex -HookEventName UserPromptSubmit",
            "timeout": 15,
            "statusMessage": "Verificando o barramento"
          }
        ]
      }
    ]
  }
}
