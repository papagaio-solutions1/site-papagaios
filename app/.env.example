# URL pública do site (usada em metadata, OpenGraph e sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (BaaS — CMS, leads, formulários)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço — APENAS no servidor. NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# Groq — "cérebro" do chat do Guto. APENAS no servidor (sem NEXT_PUBLIC).
# Chave em https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: modelo (padrão llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Telegram — notificação de novos leads (Camada 1) e, depois, chat ao vivo.
# APENAS no servidor (sem NEXT_PUBLIC). Crie o bot no @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Para onde vão os avisos: seu chat_id pessoal, ou o id do grupo/supergrupo.
TELEGRAM_CHAT_ID=
